// PathParamError is returned by a request builder, before it builds a URL, for
// a path parameter that cannot fill its own segment of that URL or that breaks
// the rule the contract declares for it. Nothing is sent.
//
// Every parameter is held to one segment. The builder percent-escapes the
// value, so `/`, `?`, `#` and `%` stay inside it, but the URL is then resolved
// against the server address per RFC 3986, which removes dot segments. Without
// the check, id ".." on deleteCluster builds
// DELETE /v1/regions/r1/projects/proj/compute/, another route. An empty value
// drops the segment the same way.
type PathParamError struct {
	// Operation is the contract's operationId, e.g. "deleteCluster".
	Operation string
	// Param is the parameter's name in the contract, e.g. "id".
	Param string
	// Value is the value the builder was given.
	Value string
	// Rule is what refused it: "segment" for a value that is not one URL
	// segment, otherwise the contract's keyword, "pattern", "minLength",
	// "maxLength" or "enum".
	Rule string
	// Reason says the same in words, with the contract's limit where it has one.
	Reason string
}

func (e *PathParamError) Error() string {
	return fmt.Sprintf("k0rdent: %s not sent: path parameter %s is %q, which %s", e.Operation, e.Param, e.Value, e.Reason)
}

// pathParamRule is the contract's rule for one path parameter. A zero field is
// not part of the rule.
type pathParamRule struct {
	pattern              *regexp.Regexp
	minLength, maxLength int
	enum                 []string
}

// checkPathParam holds a path parameter to one URL segment and to its rule.
// value is what the caller passed and segment is what the builder made of it.
// The segment is the one checked for shape because it is what the URL is
// resolved from, and a parameter the generator does not escape would carry a
// raw `/`, `?` or `#` into it.
func checkPathParam(operation, param, value, segment string, rule pathParamRule) error {
	refuse := func(kind, reason string, args ...any) error {
		return &PathParamError{Operation: operation, Param: param, Value: value, Rule: kind, Reason: fmt.Sprintf(reason, args...)}
	}
	n := utf8.RuneCountInString(value)
	switch {
	case segment == "":
		return refuse("segment", "is empty, and would drop its segment from the URL")
	case segment == "." || segment == "..":
		return refuse("segment", "is a dot segment, and would send the request to another route")
	case strings.ContainsAny(segment, "/?#"):
		return refuse("segment", "would put a raw `/`, `?` or `#` into the URL")
	case rule.pattern != nil && !rule.pattern.MatchString(value):
		return refuse("pattern", "does not match the contract's pattern `%s`", rule.pattern)
	case n < rule.minLength:
		return refuse("minLength", "is shorter than the contract's minimum of %d characters", rule.minLength)
	case rule.maxLength > 0 && n > rule.maxLength:
		return refuse("maxLength", "is longer than the contract's maximum of %d characters", rule.maxLength)
	case len(rule.enum) > 0 && !slices.Contains(rule.enum, value):
		return refuse("enum", "is not one the contract names: %s", strings.Join(rule.enum, ", "))
	}
	return nil
}

